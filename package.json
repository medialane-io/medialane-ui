{
  "name": "@medialane/ui",
  "version": "0.125.0",
  "description": "Shared UI components for Medialane apps",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preset": {
      "types": "./dist/preset/tailwind.d.ts",
      "import": "./dist/preset/tailwind.js",
      "require": "./dist/preset/tailwind.cjs"
    },
    "./styles": "./dist/medialane.css",
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js",
      "require": "./dist/data/*.cjs"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "preview": "vite --config preview/vite.config.ts"
  },
  "peerDependencies": {
    "@medialane/sdk": ">=0.73.0",
    "@radix-ui/react-checkbox": ">=1.1.0",
    "@radix-ui/react-collapsible": ">=1.1.0",
    "@radix-ui/react-dialog": ">=1.1.0",
    "@radix-ui/react-dropdown-menu": ">=2.1.0",
    "@radix-ui/react-label": ">=2.1.0",
    "@radix-ui/react-popover": ">=1.1.0",
    "@radix-ui/react-select": ">=2.1.0",
    "@radix-ui/react-slot": ">=1.1.0",
    "@radix-ui/react-switch": ">=1.1.0",
    "@radix-ui/react-tabs": ">=1.1.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "cmdk": ">=1.0.0",
    "framer-motion": ">=10.0.0",
    "lucide-react": ">=0.400.0",
    "next": ">=14.0.0",
    "next-themes": ">=0.3.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.50.0",
    "recharts": ">=2.0.0",
    "sonner": ">=1.0.0",
    "swr": ">=2.0.0",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@medialane/sdk": "0.85.5",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.0",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.8.1",
    "sonner": "^1.5.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.1"
  }
}
